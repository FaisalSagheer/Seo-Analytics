generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---- Auth ----
// NextAuth with JWT sessions and no adapter: lib/auth.ts writes User and Account itself.
// Account holds a "credential" row (password hash) and/or a "google" row (encrypted tokens).
// Session and Verification are left from the previous auth library and are no longer used.

model User {
  id              String       @id
  name            String
  email           String       @unique
  emailVerified   Boolean      @default(false)
  image           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sessions        Session[]
  accounts        Account[]
  /// Null resolves to the default role (see lib/roles.ts)
  roleId          String?
  role            Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// Deactivated users can't sign in or use an existing session or API key. Their data is kept.
  isActive        Boolean      @default(true)
  invitationsSent Invitation[] @relation("InvitedBy")
  /// Sessions issued before this moment are refused (set when the password is reset)
  sessionsValidFrom DateTime?
  /// When the user finished or skipped the first-login tour; null shows it once
  tourSeenAt        DateTime?
  /// Comma-separated page tours (see lib/tour-pages.ts) the user has finished or skipped
  pageToursSeen     String?   @db.Text
  passwordResets    PasswordReset[]

  projects            Project[]
  projectMemberships  ProjectMember[]
  linkImports         LinkImport[]
  providerCredentials ProviderCredential[]
  apiKeys             ApiKey[]

  @@index([roleId])
  @@map("user")
}

// ---- Roles ----

/// Team-wide roles. Every signed-in user can view every project; a role only
/// decides what they can change.
model Role {
  id             String       @id @default(cuid())
  name           String       @unique @db.VarChar(64)
  description    String       @default("") @db.VarChar(255)
  /// Permission keys from lib/permissions.ts
  permissions    Json
  /// The built-in Admin role: holds every permission, can't be edited or deleted
  isSystem       Boolean      @default(false)
  /// Sees every project. Off for client roles: they see only the projects they're a member of
  seeAllProjects Boolean      @default(true)
  /// Given to new sign-ups and to users whose role is deleted. Exactly one.
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  invitations    Invitation[]

  @@map("role")
}

/// Who can see a project. Admins and roles with "See every project" don't need a row.
model ProjectMember {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectMember_projectId_fkey")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProjectMember_userId_fkey")
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId], map: "ProjectMember_userId_idx")
  @@map("projectmember")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- Projects & tracking ----

model Project {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Project_userId_fkey")
  name                String
  domain              String
  locationCode        Int       @default(2840)
  device              Device    @default(DESKTOP)
  /// Search Console property, e.g. "sc-domain:example.com" or "https://example.com/"
  gscSiteUrl          String?
  /// GA4 property id, digits only
  ga4PropertyId       String?
  /// Merchant Center account id, digits only
  merchantId          String?   @db.VarChar(32)
  /// Site URL exactly as registered in Bing Webmaster Tools, e.g. "https://example.com/"
  bingSiteUrl         String?
  /// Which backlink sources a refresh fetches (each only when its account is connected)
  backlinksDataForSeo Boolean   @default(true)
  backlinksBing       Boolean   @default(true)
  isDemo              Boolean   @default(false)
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  keywords          Keyword[]
  gscDaily          SearchConsoleDaily[]
  gscQueries        SearchConsoleQuery[]
  analyticsDaily    AnalyticsDaily[]
  domainSnapshots   DomainSnapshot[]
  topPages          TopPage[]
  backlinks         Backlink[]
  backlinkSnapshots BacklinkSnapshot[]
  auditRuns         AuditRun[]
  credentials       ProjectCredential[]
  members           ProjectMember[]
  referralDaily     ReferralDaily[]
  referralPages     ReferralPage[]
  linkImports       LinkImport[]

  @@index([userId], map: "Project_userId_idx")
  @@map("project")
}

enum Device {
  DESKTOP
  MOBILE
}

model Keyword {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "Keyword_projectId_fkey")
  phrase       String         @db.VarChar(700)
  /// Comma-separated tags
  tags         String         @default("")
  searchVolume Int?
  createdAt    DateTime       @default(now())
  snapshots    RankSnapshot[]
  pages        RankPage[]

  @@unique([projectId, phrase(length: 191)], map: "Keyword_projectId_phrase_key")
  @@index([projectId], map: "Keyword_projectId_idx")
  @@map("keyword")
}

/// Search Console numbers for one keyword on one page on one day. Shows which pages rank for a keyword and when that changes.
model RankPage {
  id          String   @id @default(cuid())
  keywordId   String
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade, map: "RankPage_keywordId_fkey")
  date        DateTime @db.Date
  page        String   @db.VarChar(2048)
  /// Average position of this page for the keyword that day
  position    Float
  impressions Int
  clicks      Int

  @@index([keywordId, date], map: "RankPage_keywordId_date_idx")
  @@map("rankpage")
}

model RankSnapshot {
  id        String     @id @default(cuid())
  keywordId String
  keyword   Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade, map: "RankSnapshot_keywordId_fkey")
  checkedAt DateTime   @db.Date
  /// null = not found in the checked depth
  position  Int?
  url       String?    @db.VarChar(2048)
  source    DataSource @default(DATAFORSEO)

  @@unique([keywordId, checkedAt], map: "RankSnapshot_keywordId_checkedAt_key")
  @@index([checkedAt], map: "RankSnapshot_checkedAt_idx")
  @@map("ranksnapshot")
}

enum DataSource {
  DATAFORSEO
  SERPER
  BING
  /// Google Search Console: average position of a query, not a one-off SERP check
  GOOGLE
  DEMO
}

// ---- Search Console & GA4 ----

model SearchConsoleDaily {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "SearchConsoleDaily_projectId_fkey")
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@unique([projectId, date], map: "SearchConsoleDaily_projectId_date_key")
  @@map("searchconsoledaily")
}

/// Last-28-day query totals, replaced on every sync
model SearchConsoleQuery {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "SearchConsoleQuery_projectId_fkey")
  query       String   @db.VarChar(700)
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  syncedAt    DateTime @default(now())

  @@index([projectId], map: "SearchConsoleQuery_projectId_idx")
  @@map("searchconsolequery")
}

model AnalyticsDaily {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "AnalyticsDaily_projectId_fkey")
  date           DateTime @db.Date
  sessions       Int
  users          Int
  conversions    Int
  engagementRate Float

  @@unique([projectId, date], map: "AnalyticsDaily_projectId_date_key")
  @@map("analyticsdaily")
}

// ---- Referral links (from GA4) ----

/// Organic fields are null when only a backlink source (Bing) was available;
/// backlink fields are null when no backlink source was available.
model DomainSnapshot {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "DomainSnapshot_projectId_fkey")
  capturedAt       DateTime @db.Date
  organicKeywords  Int?
  organicTraffic   Float?
  trafficCost      Float?
  pos1             Int?
  pos2to3          Int?
  pos4to10         Int?
  backlinks        Int?
  referringDomains Int?
  domainRank       Int?

  @@unique([projectId, capturedAt], map: "DomainSnapshot_projectId_capturedAt_key")
  @@map("domainsnapshot")
}

/// Replaced on every sync
model TopPage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "TopPage_projectId_fkey")
  url       String   @db.VarChar(2048)
  traffic   Float
  keywords  Int
  pos1      Int
  syncedAt  DateTime @default(now())

  @@index([projectId], map: "TopPage_projectId_idx")
  @@map("toppage")
}

/// Backlink totals per source per day, so each source keeps its own history
/// and the Backlinks page can switch between them.
model BacklinkSnapshot {
  id               String     @id @default(cuid())
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "BacklinkSnapshot_projectId_fkey")
  capturedAt       DateTime   @db.Date
  source           DataSource
  backlinks        Int
  referringDomains Int
  /// null for Bing, which doesn't report a rank
  domainRank       Int?

  @@unique([projectId, capturedAt, source], map: "BacklinkSnapshot_projectId_capturedAt_source_key")
  @@map("backlinksnapshot")
}

/// Replaced per source on every sync. Bing only reports source URL + anchor, so
/// dofollow / rank / seen dates are null for Bing rows.
model Backlink {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "Backlink_projectId_fkey")
  urlFrom        String     @db.VarChar(2048)
  urlTo          String     @db.VarChar(2048)
  domainFrom     String
  anchor         String     @db.Text
  dofollow       Boolean?
  domainFromRank Int?
  firstSeen      DateTime?
  lastSeen       DateTime?
  isNew          Boolean    @default(false)
  isLost         Boolean    @default(false)
  source         DataSource @default(DATAFORSEO)

  @@index([projectId, source], map: "Backlink_projectId_source_idx")
  @@map("backlink")
}

// ---- Site audit (our own crawler, no third-party API) ----

/// One crawl of a project's site. Each run keeps its pages; older runs are pruned.
model AuditRun {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "AuditRun_projectId_fkey")
  status       AuditStatus @default(RUNNING)
  startUrl     String      @db.VarChar(2048)
  pagesCrawled Int         @default(0)
  /// 0-100, share of crawled pages without errors, weighted by severity
  score        Int?
  /// Site-wide findings (robots.txt, sitemap, https, ...): [{ code, severity, message }]
  siteIssues   Json?
  error        String?     @db.VarChar(500)
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  pages        AuditPage[]

  @@index([projectId, startedAt], map: "AuditRun_projectId_startedAt_idx")
  @@map("auditrun")
}

enum AuditStatus {
  RUNNING
  DONE
  FAILED
}

model AuditPage {
  id              String   @id @default(cuid())
  runId           String
  run             AuditRun @relation(fields: [runId], references: [id], onDelete: Cascade, map: "AuditPage_runId_fkey")
  url             String   @db.VarChar(2048)
  /// 0 = request failed (DNS, timeout, blocked)
  statusCode      Int
  title           String?  @db.VarChar(1000)
  metaDescription String?  @db.VarChar(2000)
  h1              String?  @db.VarChar(1000)
  h1Count         Int      @default(0)
  canonical       String?  @db.VarChar(2048)
  wordCount       Int      @default(0)
  loadMs          Int      @default(0)
  internalLinks   Int      @default(0)
  externalLinks   Int      @default(0)
  /// Issue codes from lib/audit/issues.ts
  issues          Json

  @@index([runId], map: "AuditPage_runId_idx")
  @@map("auditpage")
}

// ---- Provider accounts, cache, API keys ----

model ProviderCredential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProviderCredential_userId_fkey")
  provider        Provider
  /// Empty for key-only providers (Serper)
  login           String
  /// AES-256-GCM encrypted with APP_ENCRYPTION_KEY
  secretEncrypted String   @db.Text
  /// Serper only: how deep a rank check pages (10–100). Each page of 10 costs a credit.
  rankDepth       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider], map: "ProviderCredential_userId_provider_key")
  @@map("providercredential")
}

enum Provider {
  DATAFORSEO
  SERPER
  BING
  /// A Google service account key (Search Console + GA4), stored per project
  GOOGLE
}

/// GA4 sessions that arrived from other websites, per day and referring site. The closest free
/// thing to backlink tracking: it only sees links that sent at least one visit.
model ReferralDaily {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ReferralDaily_projectId_fkey")
  date        DateTime @db.Date
  /// The referring site, e.g. "news.ycombinator.com"
  source      String   @db.VarChar(191)
  sessions    Int
  users       Int
  conversions Int

  @@unique([projectId, date, source], map: "ReferralDaily_projectId_date_source_key")
  @@map("referraldaily")
}

/// The individual pages that sent those visits over the last 28 days. Replaced on every sync.
model ReferralPage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ReferralPage_projectId_fkey")
  /// Full referring URL
  referrer  String   @db.VarChar(2048)
  source    String   @db.VarChar(191)
  sessions  Int
  users     Int
  syncedAt  DateTime @default(now())

  @@index([projectId], map: "ReferralPage_projectId_idx")
  @@map("referralpage")
}

/// One upload of Search Console's Links report. Google has no API for it, so someone exports it
/// and uploads it here; keeping each upload is what shows new and lost linking sites over time.
model LinkImport {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "LinkImport_projectId_fkey")
  /// The day the report was exported, which the admin can set
  asOf        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull, map: "LinkImport_createdById_fkey")
  rows        LinkImportRow[]

  @@index([projectId, asOf], map: "LinkImport_projectId_asOf_idx")
  @@map("linkimport")
}

enum LinkKind {
  /// Top linking sites: links = linking pages, related = target pages
  SITE
  /// Top linked pages: links = incoming links, related = linking sites
  PAGE
  /// Top linking text: links = number of links
  TEXT
}

model LinkImportRow {
  id       String     @id @default(cuid())
  importId String
  import   LinkImport @relation(fields: [importId], references: [id], onDelete: Cascade, map: "LinkImportRow_importId_fkey")
  kind     LinkKind
  label    String     @db.VarChar(2048)
  links    Int
  related  Int?

  @@index([importId, kind], map: "LinkImportRow_importId_kind_idx")
  @@map("linkimportrow")
}

/// An invite link for someone new. Only a hash of the link is stored; it works once, until it expires.
model Invitation {
  id          String    @id @default(cuid())
  email       String    @db.VarChar(191)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "Invitation_roleId_fkey")
  tokenHash   String    @unique(map: "Invitation_tokenHash_key") @db.VarChar(64)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull, map: "Invitation_invitedById_fkey")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email], map: "Invitation_email_idx")
  @@map("invitation")
}

/// A one-time link that lets someone choose a new password. Only the token's hash is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordReset_userId_fkey")
  tokenHash String    @unique(map: "PasswordReset_tokenHash_key") @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId], map: "PasswordReset_userId_idx")
  @@map("passwordreset")
}

/// Fixed-window counters behind the sign-in, sign-up, invite and password reset limits. The key is hashed.
model RateLimit {
  key     String   @id @db.VarChar(191)
  count   Int
  resetAt DateTime

  @@index([resetAt], map: "RateLimit_resetAt_idx")
  @@map("ratelimit")
}

/// A provider key that belongs to one project (typically the client's own). Used before the
/// project owner's account-level key in ProviderCredential, which is used before the server's .env key.
model ProjectCredential {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectCredential_projectId_fkey")
  provider        Provider
  /// The service account email for GOOGLE; empty for key-only providers
  login           String
  /// AES-256-GCM encrypted with APP_ENCRYPTION_KEY
  secretEncrypted String   @db.Text
  /// Serper only: how deep a rank check pages (10-100)
  rankDepth       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, provider], map: "ProjectCredential_projectId_provider_key")
  @@map("projectcredential")
}

model ProviderCache {
  key       String   @id @db.VarChar(64)
  payload   Json
  expiresAt DateTime

  @@index([expiresAt], map: "ProviderCache_expiresAt_idx")
  @@map("providercache")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ApiKey_userId_fkey")
  name       String
  /// First characters shown in the UI, e.g. "bsk_ab12"
  prefix     String
  /// sha256 of the full key
  hashedKey  String    @unique(map: "ApiKey_hashedKey_key") @db.VarChar(64)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId], map: "ApiKey_userId_idx")
  @@map("apikey")
}
