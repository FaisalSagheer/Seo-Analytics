# ---- Required ----

# MySQL 8+ (or MariaDB 10.6+). Create the database first: CREATE DATABASE bisibility;
# Each falls back to the value shown if left out. Special characters in the password are fine.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="bisibility"
# Or give one connection string instead. If set, it wins over the DB_* values:
# DATABASE_URL="mysql://root:password@localhost:3306/bisibility"

# Public URL of the app, no trailing slash. Used for OAuth callbacks, API examples and `npm run sync`.
APP_URL="http://localhost:3000"

# Signs session cookies (NextAuth). 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 64 hex characters, encrypts the Google keys and tokens the app stores:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# ---- Google: Search Console (rankings, clicks, queries) and GA4 (traffic). Free. ----
# Two ways to give a project Google access, and you can mix them:
#  1. A service account key per project, pasted in Project settings. The client never signs in. No setting here.
#  2. Your own Google account. These are OAuth credentials, not API keys. Google Cloud console ->
#     APIs & Services -> Credentials -> OAuth client (Web application).
#     Authorized redirect URI: {APP_URL}/api/auth/callback/google
# Enable in the Cloud project: Google Search Console API, Google Analytics Data API, Google Analytics Admin API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Optional ----

# Shows "Explore the demo" on the sign-in page. Run `npm run db:seed` to create the demo account;
# with DEMO_MODE="false" the same command deletes it.
DEMO_MODE="false"

# Set to false to stop new sign-ups (existing users can still sign in)
ALLOW_SIGNUP="true"

# ---- Email (optional) ----
# Sends invitation links. Without SMTP_HOST and SMTP_FROM the admin copies the link and sends it themselves.
SMTP_HOST=""
SMTP_PORT="587"
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""   # e.g. "Seo Engine <no-reply@your-domain.com>"

# Protects POST /api/cron/sync, which `npm run sync` calls
CRON_SECRET=""

# First admin (optional). `npm run db:seed` creates this account as Admin. If the email already
# has an account it is made Admin and its password is left alone. Remove SEED_PASSWORD afterwards.
SEED_ADMIN_EMAIL=""
SEED_PASSWORD=""
