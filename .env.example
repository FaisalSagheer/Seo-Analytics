# ---- Required ----

# MySQL 8+ (or MariaDB 10.6+). Create the database first: CREATE DATABASE bisibility;
DATABASE_URL="mysql://root:password@localhost:3306/bisibility"

# Public URL of the app (used for OAuth callbacks and API examples)
AUTH_URL="http://localhost:3000"

# Signs session cookies (NextAuth). 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 64 hex characters, encrypts stored provider passwords and Google tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# ---- Google: sign-in, Search Console (rankings, clicks) and GA4 (traffic). Free. ----
# OAuth credentials, not API keys. Google Cloud console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Enable: Google Search Console API, Google Analytics Data API, Google Analytics Admin API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Optional ----

# Shows "Explore the demo" on the sign-in page. Run `npm run db:seed` to create the demo account;
# with DEMO_MODE="false" the same command deletes it.
DEMO_MODE="false"

# Set to false to stop new sign-ups (existing users can still sign in)
ALLOW_SIGNUP="true"

# Protects POST /api/cron/sync, which `npm run sync` calls
CRON_SECRET=""

# Not listed here because they are optional paid or per-user keys: DataForSEO, Serper and Bing Webmaster
# credentials are normally entered in Settings → Providers. To set them server-wide instead, use
# DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD, SERPER_API_KEY, SERPER_RANK_DEPTH and BING_WEBMASTER_API_KEY.
