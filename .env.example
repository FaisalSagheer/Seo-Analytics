# ---- Required ----

# MySQL 8+ (or MariaDB 10.6+). Create the database first: CREATE DATABASE bisibility;
DATABASE_URL="mysql://root:password@localhost:3306/bisibility"

# Public URL of the app (used for OAuth callbacks and API examples)
BETTER_AUTH_URL="http://localhost:3000"

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# 64 hex characters, encrypts stored provider passwords:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# ---- Demo mode ----

# Shows "Explore the demo" on the sign-in page. Run `npm run db:seed` to create the account.
DEMO_MODE="true"
DEMO_EMAIL="demo@bisibility.local"
DEMO_PASSWORD="demo-password-123"

# Set to false to stop new sign-ups (existing users can still sign in)
ALLOW_SIGNUP="true"

# ---- Google sign-in + Search Console + GA4 (optional) ----
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Enable: Google Search Console API, Google Analytics Data API, Google Analytics Admin API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- DataForSEO (optional server-wide fallback) ----
# Users can connect their own account in Settings. These are used when they haven't.
# API credentials from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ---- Serper (optional server-wide fallback for rank checks) ----
# 2,500 free queries at https://serper.dev. Used for rank checks instead of DataForSEO when set.
# Depth 10–100: each page of 10 results costs a credit; a check stops once the site is found.


# ---- Bing Webmaster Tools (optional server-wide fallback for backlinks, free) ----
# Bing Webmaster Tools → Settings → API access → API key. Only covers sites verified in that account.
BING_WEBMASTER_API_KEY=""

# ---- Scheduled sync ----
# Protects POST /api/cron/sync, which `npm run sync` calls
CRON_SECRET=""
