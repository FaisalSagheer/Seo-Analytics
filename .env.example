# ---- Required ----

# MySQL 8+ (or MariaDB 10.6+). Create the database first: CREATE DATABASE bisibility;
DATABASE_URL="mysql://root:password@localhost:3306/bisibility"

# Public URL of the app (used for OAuth callbacks and API examples)
BETTER_AUTH_URL="http://localhost:3000"

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# 64 hex characters, encrypts stored provider passwords:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# ---- Demo mode ----

# Shows "Explore the demo" on the sign-in page and "Add demo project" on Projects.
# Run `npm run db:seed` to create the account; with DEMO_MODE="false" the same
# command deletes the demo account and the projects it owns.
DEMO_MODE="true"
DEMO_EMAIL="demo@bisibility.local"
DEMO_PASSWORD="demo-password-123"

# Set to false to stop new sign-ups (existing users can still sign in)
ALLOW_SIGNUP="true"

# ---- Google sign-in + Search Console + GA4 (recommended, free) ----
# No paid keys are needed to run the app: Search Console supplies rankings (average
# position per tracked keyword), clicks and impressions; GA4 supplies traffic.
# These are OAuth credentials, not API keys. Each user then clicks "Connect Google"
# in Settings and picks a Search Console site and GA4 property per project.
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Enable: Google Search Console API, Google Analytics Data API, Google Analytics Admin API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- DataForSEO (optional, paid) ----
# Only needed for keyword ideas with search volume, domain overview / top pages, and
# live rank checks. Users can connect their own account in Settings; these are used when they haven't.
# API credentials from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ---- Serper (optional, free tier) ----
# Live rank checks. When set, used before DataForSEO. With neither key, rankings come from Search Console.
# 2,500 free queries at https://serper.dev.
# Depth 10–100: each page of 10 results costs a credit; a check stops once the site is found.
SERPER_API_KEY=""
SERPER_RANK_DEPTH="50"

# ---- Bing Webmaster Tools (optional, free: backlinks for your own verified sites) ----
# Bing Webmaster Tools → Settings → API access → API key. Only covers sites verified in that account.
BING_WEBMASTER_API_KEY=""

# ---- Site audit ----
# Nothing to configure: the crawler needs no API key. Run it from a project's "Site audit" page.

# ---- Scheduled sync ----
# Protects POST /api/cron/sync, which `npm run sync` calls
CRON_SECRET=""
